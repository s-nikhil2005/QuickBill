# QuickBill Environment Configuration Example

# Backend Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YourPasswordHere
DB_NAME=quickbill

# JWT Authentication
JWT_SECRET=quickbill_super_secure_jwt_key_2026_dev_prod
JWT_EXPIRES_IN=7d

# Optional Notification Services
EMAIL_USER=
EMAIL_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
